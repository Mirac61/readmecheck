package views

import (
	"readmecheck/components/badge"
	"readmecheck/components/button"
	"readmecheck/components/card"
	"readmecheck/components/dialog"
	"readmecheck/components/icon"
	"readmecheck/components/input"
	switchcomp "readmecheck/components/switch"
	"readmecheck/components/tabs"
	"readmecheck/internal/rules"
)

templ Home(data HomeData) {
	@Layout(LayoutData{Title: data.Title, Active: "home", HideFooter: true}) {
		<section>
			<div class="mx-auto flex w-full max-w-6xl flex-col justify-center px-4 py-8 sm:py-10 lg:min-h-[calc(100dvh-4rem)] lg:py-8">
				<div class="grid w-full items-center gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12">
					<div class="text-center lg:text-left">
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "mb-4 gap-1.5 px-3 py-1"}) {
							@icon.ListChecks(icon.Props{Class: "size-3.5"})
							<span>Deterministic README audits</span>
						}
						<h1 class="mx-auto max-w-2xl text-balance text-4xl font-bold tracking-tight sm:text-5xl lg:mx-0">
							Make your README{ " " }
							<br class="hidden sm:block"/>
							<span class="text-muted-foreground">worth reading.</span>
						</h1>
						<p class="mx-auto mt-4 max-w-xl text-pretty text-base leading-relaxed text-muted-foreground sm:text-lg lg:mx-0">
							Paste a GitHub repository. Get a practical, rule-based review of its README,
							metadata, visuals, links, and maintenance signals. No AI, no guesswork.
						</p>
					</div>
					<div class="w-full max-w-xl justify-self-center text-left lg:justify-self-end">
						@card.Card(card.Props{}) {
							@card.Content(card.ContentProps{Class: "p-4 sm:p-5"}) {
								<form
									action="/check"
									method="post"
									class="space-y-3"
									hx-post="/check"
									hx-target="#results"
									hx-swap="innerHTML"
									hx-indicator="#check-loading"
									hx-disabled-elt="find button[type='submit']"
								>
									<label for="repo-url" class="text-sm font-medium">GitHub repository</label>
									<div class="flex flex-col gap-2.5 sm:flex-row">
										<div class="flex-1">
											@input.Input(input.Props{
												ID:          "repo-url",
												Name:        "url",
												Type:        input.TypeURL,
												Value:       data.URL,
												Placeholder: "https://github.com/owner/repo",
												Required:    true,
												Class:       "h-10 text-base md:text-sm",
												Attributes:  templ.Attributes{"autocomplete": "off", "spellcheck": "false"},
											})
										</div>
										@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg, Class: "h-10 w-full sm:w-auto"}) {
											@icon.Search(icon.Props{Class: "size-4"})
											Check README
										}
									</div>
									<div class="flex items-start justify-between gap-4 rounded-lg border bg-muted/30 p-2.5">
										<div>
											<label for="external-links" class="text-sm font-medium">Check external links</label>
											<p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">
												Verifies up to 50 links over the network. Slower, but catches dead references.
											</p>
										</div>
										@switchcomp.Switch(switchcomp.Props{
											ID:      "external-links",
											Name:    "external",
											Value:   "1",
											Checked: data.ExternalLinks,
										})
									</div>
									if data.Error != "" {
										@ErrorAlert("Could not check this repository", data.Error)
									}
									<p class="text-xs leading-relaxed text-muted-foreground">
										Accepts <code class="rounded bg-muted px-1 py-0.5">owner/repo</code>,
										<code class="rounded bg-muted px-1 py-0.5">github.com/owner/repo</code>,
										and full URLs. Public repositories need no token.
									</p>
									<div id="check-loading" class="htmx-indicator items-center gap-2 text-sm text-muted-foreground" role="status">
										@icon.LoaderCircle(icon.Props{Class: "size-4 animate-spin"})
										<span>Fetching the repository and running 23 rules…</span>
									</div>
								</form>
							}
						}
					</div>
				</div>
				<div id="results" class="mt-6 w-full text-left empty:hidden" aria-live="polite"></div>
				<div class="mt-6 grid w-full gap-3 text-left sm:grid-cols-3 lg:mt-7">
					@featureCard("rules-dialog", "23 rules", "Checks structure, links, visuals, metadata, and maintenance signals.", "list-checks", featureRulesBody())
					@featureCard("evidence-dialog", "Real evidence", "Shows the exact lines, links, and missing files behind each result.", "shield-check", featureEvidenceBody())
					@featureCard("privacy-dialog", "Private by default", "Runs locally. No account, no LLM, no telemetry.", "code", featurePrivateBody())
				</div>
			</div>
		</section>
	}
}

templ featureCard(id, title, description, iconName string, body templ.Component) {
	@card.Card(card.Props{
		Class: "group relative flex h-full flex-col transition-colors hover:border-foreground/20 focus-within:ring-[3px] focus-within:ring-ring/50",
	}) {
		@card.Header(card.HeaderProps{Class: "flex-row items-center gap-2.5 space-y-0 p-4 pb-0"}) {
			<span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted text-muted-foreground">
				@featureIcon(iconName)
			</span>
			@card.Title(card.TitleProps{Class: "text-lg leading-tight"}) {
				@dialog.Trigger(dialog.TriggerProps{For: id}) {
					@button.Button(button.Props{
						Type:    button.TypeButton,
						Variant: button.VariantGhost,
						Class:   "h-auto justify-start whitespace-normal p-0 text-left text-lg font-semibold leading-tight text-foreground hover:bg-transparent hover:text-foreground focus-visible:ring-0 after:absolute after:inset-0 after:z-10 after:rounded-lg after:content-['']",
						Attributes: templ.Attributes{
							"aria-haspopup": "dialog",
							"aria-controls": id,
						},
					}) {
						{ title }
					}
				}
			}
		}
		@card.Content(card.ContentProps{Class: "flex-1 px-4 pb-2 pt-2"}) {
			@card.Description(card.DescriptionProps{Class: "text-[15px] leading-relaxed text-muted-foreground"}) {
				{ description }
			}
		}
		@card.Footer(card.FooterProps{Class: "p-4 pt-2"}) {
			<span class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground transition-colors group-hover:text-foreground" aria-hidden="true">
				Details
				@icon.ArrowRight(icon.Props{Class: "size-4 transition-transform group-hover:translate-x-0.5"})
			</span>
		}
	}
	@dialog.Dialog(dialog.Props{ID: id}) {
		@dialog.Content(dialog.ContentProps{Class: "max-h-[85vh] max-w-[calc(100%-2rem)] gap-0 overflow-hidden bg-card p-0 sm:max-w-4xl"}) {
			@dialog.Header(dialog.HeaderProps{Class: "flex-row items-start justify-between gap-4 border-b p-5 pr-14 text-left"}) {
				<div class="flex min-w-0 items-start gap-3">
					<span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-muted text-muted-foreground">
						@featureIcon(iconName)
					</span>
					<div class="min-w-0">
						@dialog.Title(dialog.TitleProps{Class: "text-lg"}) {
							{ title }
						}
						@dialog.Description(dialog.DescriptionProps{Class: "mt-1 text-[15px] leading-relaxed"}) {
							{ description }
						}
					</div>
				</div>
			}
			<div class="min-h-0 flex-1 overflow-y-auto p-5 sm:p-6">
				@body
			</div>
		}
	}
}

templ featureRulesBody() {
	{{ catalog := rules.Catalog() }}
	<p class="max-w-3xl text-[15px] leading-relaxed text-muted-foreground">
		Every audit runs the same 23 deterministic checks across seven categories. No model, no randomness, no hidden criteria.
	</p>
	<p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
		<span class="inline-flex items-center gap-1.5">
			<span class={ "size-1.5 rounded-full", severityDotClass(rules.SeverityError) } aria-hidden="true"></span>
			Error
		</span>
		<span class="inline-flex items-center gap-1.5">
			<span class={ "size-1.5 rounded-full", severityDotClass(rules.SeverityWarning) } aria-hidden="true"></span>
			Warning
		</span>
		<span class="inline-flex items-center gap-1.5">
			<span class={ "size-1.5 rounded-full", severityDotClass(rules.SeverityInfo) } aria-hidden="true"></span>
			Info
		</span>
	</p>
	@tabs.Tabs(tabs.Props{ID: "rules-tabs", Class: "mt-5 gap-3"}) {
		@tabs.List(tabs.ListProps{Class: "w-full justify-start overflow-x-auto"}) {
			for i, group := range catalog {
				@tabs.Trigger(tabs.TriggerProps{Value: string(group.Category), IsActive: i == 0, Class: "flex-none px-3"}) {
					{ group.Label }
				}
			}
		}
		for i, group := range catalog {
			@tabs.Content(tabs.ContentProps{Value: string(group.Category), IsActive: i == 0, Class: "pt-2"}) {
				<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{ len(group.Rules) } checks</p>
				<ul class="mt-2 space-y-2">
					for _, rule := range group.Rules {
						<li class="flex items-start gap-2.5 text-[15px] leading-relaxed">
							<span class={ "mt-2 size-1.5 shrink-0 rounded-full", severityDotClass(rule.Severity) } aria-hidden="true"></span>
							<span>{ rule.Title }</span>
						</li>
					}
				</ul>
			}
		}
	}
}

templ featureEvidenceBody() {
	<p class="max-w-3xl text-[15px] leading-relaxed text-muted-foreground">
		Checks return the exact evidence they found, not just a score. Every failed result includes the relevant excerpt, a short rationale, and a concrete fix.
	</p>
	<div class="mt-4 grid gap-3 sm:grid-cols-3">
		@card.Card(card.Props{Class: "bg-muted/30 shadow-none"}) {
			@card.Header(card.HeaderProps{Class: "p-3 pb-0"}) {
				@card.Title(card.TitleProps{Class: "flex items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-muted-foreground"}) {
					@icon.Search(icon.Props{Class: "size-3.5"})
					Evidence
				}
			}
			@card.Content(card.ContentProps{Class: "p-3 pt-2"}) {
				@card.Description(card.DescriptionProps{Class: "text-sm leading-relaxed"}) {
					The lines, links, or missing files behind the result.
				}
			}
		}
		@card.Card(card.Props{Class: "bg-muted/30 shadow-none"}) {
			@card.Header(card.HeaderProps{Class: "p-3 pb-0"}) {
				@card.Title(card.TitleProps{Class: "flex items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-foreground"}) {
					@icon.Lightbulb(icon.Props{Class: "size-3.5 text-amber-700 dark:text-amber-400"})
					Why it matters
				}
			}
			@card.Content(card.ContentProps{Class: "p-3 pt-2"}) {
				@card.Description(card.DescriptionProps{Class: "text-sm leading-relaxed"}) {
					A short explanation of the impact on first-time readers.
				}
			}
		}
		@card.Card(card.Props{Class: "bg-muted/30 shadow-none"}) {
			@card.Header(card.HeaderProps{Class: "p-3 pb-0"}) {
				@card.Title(card.TitleProps{Class: "flex items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-foreground"}) {
					@icon.Wrench(icon.Props{Class: "size-3.5 text-emerald-700 dark:text-emerald-400"})
					How to fix
				}
			}
			@card.Content(card.ContentProps{Class: "p-3 pt-2"}) {
				@card.Description(card.DescriptionProps{Class: "text-sm leading-relaxed"}) {
					A specific change that resolves the check.
				}
			}
		}
	</div>
}

templ featurePrivateBody() {
	<p class="max-w-3xl text-[15px] leading-relaxed text-muted-foreground">
		readmecheck is a local Go server. It fetches public data from GitHub, runs every rule in-process, and stores check history in a local SQLite file.
	</p>
	<div class="mt-4 grid gap-2 sm:grid-cols-3">
		@card.Card(card.Props{Class: "bg-muted/30 shadow-none"}) {
			@card.Header(card.HeaderProps{Class: "p-3 pb-0"}) {
				@card.Title(card.TitleProps{Class: "text-sm"}) {
					No account
				}
			}
			@card.Content(card.ContentProps{Class: "p-3 pt-1"}) {
				@card.Description(card.DescriptionProps{Class: "text-sm leading-relaxed"}) {
					Public repositories work without a token.
				}
			}
		}
		@card.Card(card.Props{Class: "bg-muted/30 shadow-none"}) {
			@card.Header(card.HeaderProps{Class: "p-3 pb-0"}) {
				@card.Title(card.TitleProps{Class: "text-sm"}) {
					No LLM
				}
			}
			@card.Content(card.ContentProps{Class: "p-3 pt-1"}) {
				@card.Description(card.DescriptionProps{Class: "text-sm leading-relaxed"}) {
					Every result comes from deterministic rules.
				}
			}
		}
		@card.Card(card.Props{Class: "bg-muted/30 shadow-none"}) {
			@card.Header(card.HeaderProps{Class: "p-3 pb-0"}) {
				@card.Title(card.TitleProps{Class: "text-sm"}) {
					No telemetry
				}
			}
			@card.Content(card.ContentProps{Class: "p-3 pt-1"}) {
				@card.Description(card.DescriptionProps{Class: "text-sm leading-relaxed"}) {
					History stays in the local database.
				}
			}
		}
	</div>
}
