package views

import (
	"readmecheck/components/badge"
	"readmecheck/components/button"
	"readmecheck/components/card"
	"readmecheck/components/dialog"
	"readmecheck/components/icon"
	"readmecheck/components/input"
	switchcomp "readmecheck/components/switch"
	"readmecheck/components/tabs"
	"readmecheck/internal/rules"
)

templ Home(data HomeData) {
	@Layout(LayoutData{Title: data.Title, Active: "home"}) {
		<section class="flex flex-1 flex-col">
			<div class="mx-auto flex w-full max-w-[110rem] flex-1 flex-col justify-center gap-10 px-4 py-10 sm:px-6 lg:gap-16 lg:px-10 lg:py-16">
				<div class="grid w-full items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 xl:gap-24">
					<div class="text-center lg:text-left">
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "mb-5 gap-1.5 px-3 py-1"}) {
							@icon.ListChecks(icon.Props{Class: "size-3.5"})
							<span>Deterministic README audits</span>
						}
						<h1 class="mx-auto max-w-3xl text-balance text-4xl font-bold tracking-tight sm:text-5xl lg:mx-0 lg:text-6xl xl:text-7xl">
							Make your README{ " " }
							<br class="hidden sm:block"/>
							<span class="text-muted-foreground">worth reading.</span>
						</h1>
						<p class="mx-auto mt-6 max-w-2xl text-pretty text-base leading-relaxed text-muted-foreground sm:text-lg xl:text-xl lg:mx-0">
							Paste a GitHub repository. Get a practical, rule-based review of its README,
							metadata, visuals, links, and maintenance signals. No AI, no guesswork.
						</p>
					</div>
					<div class="w-full max-w-xl justify-self-center text-left lg:max-w-2xl lg:justify-self-end">
						@card.Card(card.Props{}) {
							@card.Content(card.ContentProps{Class: "p-4 sm:p-5"}) {
								<form
									action="/check"
									method="post"
									class="space-y-3"
									hx-post="/check"
									hx-target="#results"
									hx-swap="innerHTML"
									hx-indicator="#check-loading"
									hx-disabled-elt="find button[type='submit']"
								>
									<label for="repo-url" class="text-sm font-medium">GitHub repository</label>
									<div class="flex flex-col gap-2.5 sm:flex-row">
										<div class="flex-1">
											@input.Input(input.Props{
												ID:          "repo-url",
												Name:        "url",
												Type:        input.TypeURL,
												Value:       data.URL,
												Placeholder: "https://github.com/owner/repo",
												Required:    true,
												Class:       "h-10 text-base md:text-sm",
												Attributes:  templ.Attributes{"autocomplete": "off", "spellcheck": "false"},
											})
										</div>
										@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg, Class: "h-10 w-full sm:w-auto"}) {
											@icon.Search(icon.Props{Class: "size-4"})
											Check README
										}
									</div>
									<div class="flex items-start justify-between gap-4 border-t border-b py-3">
										<div>
											<label for="external-links" class="text-sm font-medium">Check external links</label>
											<p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">
												Checks up to 50 links online. Slower, finds dead ones.
											</p>
										</div>
										@switchcomp.Switch(switchcomp.Props{
											ID:      "external-links",
											Name:    "external",
											Value:   "1",
											Checked: data.ExternalLinks,
										})
									</div>
									if data.Error != "" {
										@ErrorAlert("Could not check this repository", data.Error)
									}
									<p class="text-sm leading-relaxed text-muted-foreground/90">
										Accepts <code class="rounded bg-muted px-1 py-0.5">owner/repo</code>,
										<code class="rounded bg-muted px-1 py-0.5">github.com/owner/repo</code>,
										and full URLs.
									</p>
									<div id="check-loading" class="htmx-indicator items-center gap-2 text-sm text-muted-foreground" role="status">
										@icon.LoaderCircle(icon.Props{Class: "size-4 animate-spin"})
										<span>Fetching the repository and running 23 rules…</span>
									</div>
								</form>
								<div class="mt-3 flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground">
									<span class="mr-0.5">Try an example:</span>
									for _, example := range []string{"charmbracelet/bubbletea", "spf13/cobra", "jesseduffield/lazygit"} {
										<a
											href={ templ.SafeURL("/report/" + example) }
											class="rounded-md border bg-muted/40 px-2 py-1 font-medium text-foreground/80 transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
										>{ example }</a>
									}
								</div>
							}
						}
					</div>
				</div>
				<div id="results" class="w-full scroll-mt-20 text-left empty:hidden" aria-live="polite"></div>
				<div id="feature-cards" class="grid w-full gap-4 text-left sm:grid-cols-3 lg:gap-6">
					@featureCard("rules-dialog", "23 rules", "Structure, links, visuals, metadata, and maintenance signals in seven categories.", "list-checks", featureRulesBody())
					@featureCard("evidence-dialog", "Real evidence", "Every failed check names what it found, why it matters, and how to fix it.", "shield-check", featureEvidenceBody())
					@featureCard("privacy-dialog", "Private by default", "Runs on your machine. Nothing is sent to us.", "code", featurePrivateBody())
				</div>
			</div>
		</section>
	}
}

templ featureCard(id, title, description, iconName string, body templ.Component) {
	@card.Card(card.Props{
		Class: "group relative flex h-full flex-col transition-colors hover:border-foreground/30 hover:bg-accent/30 focus-within:ring-[3px] focus-within:ring-ring/50",
	}) {
		@card.Header(card.HeaderProps{Class: "flex-row items-center gap-2.5 space-y-0 p-4 pb-0"}) {
			<span class={ "flex size-8 shrink-0 items-center justify-center rounded-md", "bg-muted text-muted-foreground" }>
				@featureIcon(iconName)
			</span>
			@card.Title(card.TitleProps{Class: "text-lg leading-tight"}) {
				@dialog.Trigger(dialog.TriggerProps{For: id}) {
					@button.Button(button.Props{
						Type:    button.TypeButton,
						Variant: button.VariantGhost,
						Class:   "h-auto justify-start whitespace-normal p-0 text-left text-lg font-semibold leading-tight text-foreground hover:bg-transparent hover:text-foreground focus-visible:ring-0 after:absolute after:inset-0 after:z-10 after:rounded-lg after:content-['']",
						Attributes: templ.Attributes{
							"aria-haspopup": "dialog",
							"aria-controls": id,
						},
					}) {
						{ title }
					}
				}
			}
		}
		@card.Content(card.ContentProps{Class: "flex-1 px-4 pb-3 pt-2"}) {
			@card.Description(card.DescriptionProps{Class: "text-[15px] leading-relaxed text-muted-foreground"}) {
				{ description }
			}
		}
		@card.Footer(card.FooterProps{Class: "border-t border-border/60 px-4 py-3"}) {
			<span class="inline-flex items-center gap-1.5 text-sm font-medium text-foreground/80 transition-colors group-hover:text-foreground" aria-hidden="true">
				Details
				@icon.ArrowRight(icon.Props{Class: "size-4 transition-transform group-hover:translate-x-0.5"})
			</span>
		}
	}
	@dialog.Dialog(dialog.Props{ID: id}) {
		@dialog.Content(dialog.ContentProps{Class: "max-h-[85vh] max-w-[calc(100%-2rem)] gap-0 overflow-hidden bg-card p-0 " + dialogSizeClass(id)}) {
			@dialog.Header(dialog.HeaderProps{Class: "flex-row items-start justify-between gap-4 border-b p-5 pr-14 text-left"}) {
				<div class="flex min-w-0 items-start gap-3">
					<span class={ "flex size-9 shrink-0 items-center justify-center rounded-lg", "bg-muted text-muted-foreground" }>
						@featureIcon(iconName)
					</span>
					<div class="min-w-0">
						@dialog.Title(dialog.TitleProps{Class: "text-lg"}) {
							{ title }
						}
						@dialog.Description(dialog.DescriptionProps{Class: "mt-1 text-[15px] leading-relaxed"}) {
							{ description }
						}
					</div>
				</div>
			}
			<div class="min-h-0 flex-1 overflow-y-auto p-5 sm:p-6">
				@body
			</div>
		}
	}
}

templ featureRulesBody() {
	{{ catalog := rules.Catalog() }}
	@tabs.Tabs(tabs.Props{ID: "rules-tabs", Class: "gap-4"}) {
		@tabs.List(tabs.ListProps{Class: "sticky top-0 z-10 h-auto w-full flex-wrap justify-start gap-1 p-1 shadow-xs"}) {
			for i, group := range catalog {
				@tabs.Trigger(tabs.TriggerProps{Value: string(group.Category), IsActive: i == 0, Class: "flex-1 whitespace-nowrap px-3 py-1.5"}) {
					{ group.Label }
				}
			}
		}
		<p class="max-w-3xl text-[15px] leading-relaxed text-muted-foreground">
			Every audit runs the same checks in the same order. Open a rule to see why it matters and how to fix it. The dot and label show its severity.
		</p>
		for i, group := range catalog {
			@tabs.Content(tabs.ContentProps{Value: string(group.Category), IsActive: i == 0, Class: "pt-0"}) {
				<p class="text-sm font-medium text-muted-foreground">{ len(group.Rules) } { plural(len(group.Rules), "check", "checks") }</p>
				<ul class="mt-2.5 divide-y divide-border/60">
					for _, rule := range group.Rules {
						<li class="py-2.5">
							<details class="group/rule">
								<summary class="flex cursor-pointer list-none items-start gap-2.5 rounded-sm text-[15px] leading-relaxed focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 [&::-webkit-details-marker]:hidden">
									<span class={ "mt-2 size-1.5 shrink-0 rounded-full", severityDotClass(rule.Severity) } aria-hidden="true"></span>
									<span class="flex-1">{ rule.Title }</span>
									@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "shrink-0 text-sm font-medium capitalize " + severityClass(rule.Severity)}) {
										{ severityLabel(rule.Severity) }
									}
									@icon.ChevronDown(icon.Props{Class: "mt-1.5 size-4 shrink-0 text-muted-foreground transition-transform group-open/rule:rotate-180"})
								</summary>
								<div class="mt-2 space-y-1.5 pl-4 text-sm leading-relaxed text-muted-foreground">
									<p><span class="font-medium text-foreground">Why: </span>{ rule.Why }</p>
									<p><span class="font-medium text-foreground">Fix: </span>{ rule.Fix }</p>
								</div>
							</details>
						</li>
					}
				</ul>
			}
		}
	}
}

templ featureEvidenceBody() {
	{{ example, _ := exampleRule("installation-section") }}
	<p class="max-w-2xl text-[15px] leading-relaxed text-muted-foreground">
		A failed check never stops at "fail". Each one comes with three parts. Example, for the check <strong class="font-medium text-foreground">"{ example.Title }"</strong>:
	</p>
	<div class="mt-4 space-y-2.5">
		@card.Card(card.Props{Class: "bg-muted/30 shadow-none"}) {
			@card.Header(card.HeaderProps{Class: "p-3 pb-0"}) {
				@card.Title(card.TitleProps{Class: "flex items-center gap-1.5 text-sm font-medium uppercase tracking-wide text-muted-foreground"}) {
					@icon.Search(icon.Props{Class: "size-3.5"})
					Evidence
				}
			}
			@card.Content(card.ContentProps{Class: "p-3 pt-2"}) {
				@card.Description(card.DescriptionProps{Class: "text-sm leading-relaxed"}) {
					What the check actually found or missed in your repository: <code class="rounded bg-muted px-1 py-0.5">No installation, setup, or getting-started heading was found.</code>
				}
			}
		}
		@card.Card(card.Props{Class: "bg-muted/30 shadow-none"}) {
			@card.Header(card.HeaderProps{Class: "p-3 pb-0"}) {
				@card.Title(card.TitleProps{Class: "flex items-center gap-1.5 text-sm font-medium uppercase tracking-wide text-foreground"}) {
					@icon.Lightbulb(icon.Props{Class: "size-3.5 text-warning"})
					Why it matters
				}
			}
			@card.Content(card.ContentProps{Class: "p-3 pt-2"}) {
				@card.Description(card.DescriptionProps{Class: "text-sm leading-relaxed"}) {
					{ example.Why }
				}
			}
		}
		@card.Card(card.Props{Class: "bg-muted/30 shadow-none"}) {
			@card.Header(card.HeaderProps{Class: "p-3 pb-0"}) {
				@card.Title(card.TitleProps{Class: "flex items-center gap-1.5 text-sm font-medium uppercase tracking-wide text-foreground"}) {
					@icon.Wrench(icon.Props{Class: "size-3.5 text-success"})
					How to fix
				}
			}
			@card.Content(card.ContentProps{Class: "p-3 pt-2"}) {
				@card.Description(card.DescriptionProps{Class: "text-sm leading-relaxed"}) {
					{ example.Fix }
				}
			}
		}
	</div>
}

templ featurePrivateBody() {
	<p class="max-w-3xl text-[15px] leading-relaxed text-muted-foreground">
		Everything runs on your machine. Only the GitHub API and, if enabled, the links in the README are contacted. Results are stored in a local SQLite file. An optional GITHUB_TOKEN is used for requests and never saved or shown.
	</p>
	<div class="mt-4 grid gap-2 sm:grid-cols-3">
		@card.Card(card.Props{Class: "bg-muted/30 shadow-none"}) {
			@card.Header(card.HeaderProps{Class: "p-3 pb-0"}) {
				@card.Title(card.TitleProps{Class: "text-sm"}) {
					No account
				}
			}
			@card.Content(card.ContentProps{Class: "p-3 pt-1"}) {
				@card.Description(card.DescriptionProps{Class: "text-sm leading-relaxed"}) {
					Public repositories work without a token.
				}
			}
		}
		@card.Card(card.Props{Class: "bg-muted/30 shadow-none"}) {
			@card.Header(card.HeaderProps{Class: "p-3 pb-0"}) {
				@card.Title(card.TitleProps{Class: "text-sm"}) {
					No LLM
				}
			}
			@card.Content(card.ContentProps{Class: "p-3 pt-1"}) {
				@card.Description(card.DescriptionProps{Class: "text-sm leading-relaxed"}) {
					Every result comes from deterministic rules.
				}
			}
		}
		@card.Card(card.Props{Class: "bg-muted/30 shadow-none"}) {
			@card.Header(card.HeaderProps{Class: "p-3 pb-0"}) {
				@card.Title(card.TitleProps{Class: "text-sm"}) {
					No telemetry
				}
			}
			@card.Content(card.ContentProps{Class: "p-3 pt-1"}) {
				@card.Description(card.DescriptionProps{Class: "text-sm leading-relaxed"}) {
					History stays in the local database.
				}
			}
		}
	</div>
}
